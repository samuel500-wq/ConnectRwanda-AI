# ====================================================================
# ConnectRwanda AI — Unified Platform Environment Configuration
# ====================================================================

# Port allocations for Local Development
# Platform Landing: 3002
# RouteView Frontend: 3000
# MapForAll Client: 3001
# RouteView Backend API: 4000
# RouteView ML Service: 8000
# MapForAll MongoDB MCP Sidecar: 3100
# MapForAll ADK Agents (if local): 8080

# Cross-Service URLs (Development defaults)
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3002
NEXT_PUBLIC_ROUTEVIEW_URL=http://localhost:3000
NEXT_PUBLIC_MAPFORALL_URL=http://localhost:3001
NEXT_PUBLIC_ROUTEVIEW_API_URL=http://localhost:4000
NEXT_PUBLIC_ROUTEVIEW_ML_URL=http://localhost:8000
NEXT_PUBLIC_MAPFORALL_MCP_URL=http://localhost:3100/mcp

# Production Base Path (Empty string for host-based subdomains; '/routeview' or '/mapforall' for path-based proxy)
NEXT_PUBLIC_BASE_PATH=

# Production Hostnames (Recommended: Host-Based Routing)
# Platform: https://connectrwanda.ai
# RouteView: https://routeview.connectrwanda.ai
# MapForAll: https://mapforall.connectrwanda.ai
