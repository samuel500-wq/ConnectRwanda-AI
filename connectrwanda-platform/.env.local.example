# .env.local.example — copy to .env.local

# Base URLs of the two engines. In dev they run on separate ports.
NEXT_PUBLIC_ROUTEVIEW_URL=http://localhost:3000
NEXT_PUBLIC_MAPFORALL_URL=http://localhost:3001

# Optional route overrides (leave blank to use defaults set in lib/links.ts)
# Set these once you confirm the real route paths in each app.
NEXT_PUBLIC_ROUTEVIEW_PLAN_PATH=
NEXT_PUBLIC_ROUTEVIEW_MAP_PATH=
NEXT_PUBLIC_ROUTEVIEW_ROUTES_PATH=
NEXT_PUBLIC_ROUTEVIEW_TICKETS_PATH=
NEXT_PUBLIC_ROUTEVIEW_ADMIN_PATH=

NEXT_PUBLIC_MAPFORALL_DISCOVER_PATH=
NEXT_PUBLIC_MAPFORALL_CHAT_PATH=
NEXT_PUBLIC_MAPFORALL_BUSINESS_PATH=