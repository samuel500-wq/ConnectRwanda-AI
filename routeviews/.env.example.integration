# ====================================================================
# RouteView Integration Environment Variables
# Copy these keys into your RouteView .env or frontend/.env.local
# ====================================================================

# Sibling App Cross-Navigation (MapForAll Accessible Discovery)
NEXT_PUBLIC_MAPFORALL_URL=http://localhost:3001

# Unified Platform Landing Page
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3002

# Optional Production Next.js Base Path (leave empty if using host routing: routeview.connectrwanda.ai)
NEXT_PUBLIC_BASE_PATH=
